[Unit]
Description=Ксения: мозг (Ternary Bonsai 2 27B + MTP + зрение на RTX 5060 Ti, :18100)
# 5060 Ti принадлежит Ксении; модели Nexus, которые её занимают, не должны работать одновременно
Conflicts=ksenia-brain-nex.service nexus-llama.service nexus-tinfield.service nexus-ornith.service nexus-nex.service

[Service]
Type=simple
ExecStart=/home/user/Agents/Ksenia/brain/run_brain.sh
# always: и после внешнего kill с кодом 0 (аудит Fable, FA15); stop и Conflicts= по-прежнему останавливают
Restart=always
RestartSec=20s
TimeoutStopSec=60s
StandardOutput=append:/home/user/Agents/Ksenia/logs/brain.log
StandardError=append:/home/user/Agents/Ksenia/logs/brain.log

[Install]
WantedBy=default.target
