[Unit]
Description=Ксения: шлюз планшета (PWA, HTTPS :18140 в домашней сети)
After=ksenia-core.service ksenia-voice-in.service network-online.target

[Service]
Type=simple
ExecStart=/home/user/Agents/Ksenia/pwa/run_pwa.sh
# always: и после внешнего kill с кодом 0 (аудит Fable, FA15); stop и Conflicts= по-прежнему останавливают
Restart=always
RestartSec=10s
StandardOutput=append:/home/user/Agents/Ksenia/logs/pwa.log
StandardError=append:/home/user/Agents/Ksenia/logs/pwa.log

[Install]
WantedBy=default.target
