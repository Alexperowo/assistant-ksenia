[Unit]
Description=Ксения: ядро (разговор, характер, озвучка, :18130)
# после рабочего стола: иначе у ядра нет DISPLAY (Cinnamon, X11; раньше WAYLAND_DISPLAY в KDE) — снимки экрана, буфер обмена, видео не работали бы
# до первого перезапуска (2026-10-10: ядро стартовало на 11 с раньше graphical-session.target)
After=ksenia-brain.service ksenia-voice-out.service ksenia-voice-in.service graphical-session.target

[Service]
# пути к моделям и движкам — одно место (config/paths.env, переезд 2026-10-13)
EnvironmentFile=%h/Agents/Ksenia/config/paths.env
# Вывод pactl, nmcli, bluetoothctl, apt разбирается по английским словам («Active Profile», «connected»).
# Русские переводы этих программ (language-pack-ru, чистая установка Kubuntu) сломали бы разбор — сообщения
# программ всегда по-английски; язык Ксении от этого не зависит (2026-10-11)
Environment=LC_MESSAGES=C.UTF-8
Environment=LANGUAGE=
Type=simple
WorkingDirectory=/home/user/Agents/Ksenia/core
ExecStart=/home/user/Agents/Ksenia/.venv/bin/python core.py
# always: и после внешнего kill с кодом 0 (аудит Fable, FA15); stop и Conflicts= по-прежнему останавливают
Restart=always
RestartSec=5s
StandardOutput=append:/home/user/Agents/Ksenia/logs/core.log
StandardError=append:/home/user/Agents/Ksenia/logs/core.log

[Install]
WantedBy=graphical-session.target
