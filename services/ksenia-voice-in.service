[Unit]
Description=Ксения: слух (Whisper large-v3-turbo на RTX 2080 Ti, :18120)

[Service]
Type=simple
ExecStart=/home/user/Agents/Ksenia/voice-in/run_voice_in.sh
Restart=on-failure
RestartSec=10s
StandardOutput=append:/home/user/Agents/Ksenia/logs/voice-in.log
StandardError=append:/home/user/Agents/Ksenia/logs/voice-in.log

[Install]
WantedBy=default.target
