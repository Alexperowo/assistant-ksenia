[Unit]
Description=Ксения: голос (Fish S2 Pro через s2.cpp на RTX 2080 Ti, :18110)

[Service]
# пути к моделям и движкам — одно место (config/paths.env, переезд 2026-10-13)
EnvironmentFile=%h/Agents/Ksenia/config/paths.env
Type=simple
ExecStart=/home/user/Agents/Ksenia/voice-out/run_voice_out.sh
# always: и после внешнего kill с кодом 0 (аудит Fable, FA15); stop и Conflicts= по-прежнему останавливают
Restart=always
RestartSec=10s
StandardOutput=append:/home/user/Agents/Ksenia/logs/voice-out.log
StandardError=append:/home/user/Agents/Ksenia/logs/voice-out.log

[Install]
WantedBy=default.target
