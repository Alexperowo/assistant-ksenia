[Unit]
Description=Ксения: обход замедления YouTube только для её инструментов (byedpi + мостик, 127.0.0.1:10801/10802)

[Service]
Type=simple
ExecStart=/usr/bin/python3 /home/user/Agents/Ksenia/net/unblock.py
# always: и после внешнего kill с кодом 0 (аудит Fable, FA15); stop и Conflicts= по-прежнему останавливают
Restart=always
RestartSec=5s
StandardOutput=append:/home/user/Agents/Ksenia/logs/unblock.log
StandardError=append:/home/user/Agents/Ksenia/logs/unblock.log

[Install]
WantedBy=default.target
